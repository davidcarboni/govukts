{
  "name": "@carboni/govukts",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/carboni/govukts"
  },
  "bugs": {
    "url": "https://github.com/carboni/govukts/issues"
  },
  "homepage": "https://github.com/carboni/govukts",
  "author": "David Carboni",
  "description": "Types and rendering functions for GOV.UK frontend components",
  "keywords": [
    "govuk",
    "frontend",
    "components",
    "templates",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "build": "npm run generate && tsx scripts/bundle.ts",
    "clean": "rm -rf dist src/generated src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/nunjucks": "*",
    "@types/node": "*",
    "esbuild": "*",
    "govuk-frontend": "^6.1.0",
    "nunjucks": "*",
    "tsx": "*",
    "typescript": "*"
  }
}
